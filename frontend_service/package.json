{
  "name": "relibank",
  "private": true,
  "type": "module",
  "scripts": {
    "build:mfe:ad-banner": "cd microfrontends/ad-banner && vite build",
    "dev:mfe:ad-banner": "cd microfrontends/ad-banner && vite build --watch",
    "build:mfe:spending-chart": "cd microfrontends/spending-chart && vite build",
    "dev:mfe:spending-chart": "cd microfrontends/spending-chart && vite build --watch",
    "build:mfe:spending-categories": "cd microfrontends/spending-categories && vite build",
    "dev:mfe:spending-categories": "cd microfrontends/spending-categories && vite build --watch",
    "build:mfe:account-balance-trends": "cd microfrontends/account-balance-trends && vite build",
    "dev:mfe:account-balance-trends": "cd microfrontends/account-balance-trends && vite build --watch",
    "build:all": "npm run build:mfe:ad-banner && npm run build:mfe:spending-chart && npm run build:mfe:spending-categories && npm run build:mfe:account-balance-trends && npm run build",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@newrelic/browser-agent": "^1.312.1",
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "isbot": "^5.2.1",
    "mui": "^0.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/ui": "^4.1.10",
    "happy-dom": "^20.11.2",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  }
}
